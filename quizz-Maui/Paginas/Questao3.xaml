<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="quizz_Maui.Paginas.Questao3"
             Title="Pergunta31">
    <VerticalStackLayout Margin="20">
        
        <Label 
            x:Name="LBLPergunta"
            Text="Quantas rodas tem esse carro?"
            FontSize="Large"
            VerticalOptions="Center" 
            HorizontalOptions="Center"
            HorizontalTextAlignment="Center"
            TextColor="#003"
            FontAttributes="Bold"
            Padding="10"
            />
        
                <Image Source="carro.jpg" />

        <Border  Stroke="DarkGray" StrokeThickness="3" StrokeShape="RoundRectangle 20,0,0,20" Background="GhostWhite">

            <Border.Shadow>
                <Shadow
                    Brush="Black"
                    Opacity="0.8"
                    Radius="9"
                    Offset="10,10"
                    />
            </Border.Shadow>
            
            <VerticalStackLayout Margin="20,20">
                <RadioButton
                    Content="3"
                    FontSize="23"
                    TextColor="DarkBlue"
                    FontAttributes="Italic"
                    CheckedChanged="verificar"
                    Value="certo"
                    />
        
                <RadioButton
                    Content="4"
                    FontSize="23"
                    TextColor="DarkBlue"
                    FontAttributes="Italic"
                    CheckedChanged="verificar"
                    Value="errado"
                    />
        
                <RadioButton
                    Content="8"
                    FontSize="23"
                    TextColor="DarkBlue"
                    Value="errado"
                    FontAttributes="Italic"
                    CheckedChanged="verificar"
                    />

                <RadioButton
                    Content="6"
                    FontSize="23"
                    FontAttributes="Italic"
                    TextColor="DarkBlue"
                    CheckedChanged="verificar"
                    Value="errado"
                    />
            </VerticalStackLayout>
            
        </Border>
        
        <Button
            x:Name="BTNVerificar"
            Text="Responder"
            FontAttributes="Bold"
            Margin="0,60"
            FontSize="30"
            Clicked="BTNVerificar_Clicked"
            />
    
    </VerticalStackLayout>
</ContentPage>